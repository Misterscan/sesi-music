allow "db" in with DB

export fn handle_config(req) {
  if req.method == "POST" && req.path == "/save-config" {
    try {
      let body_parsed = from_json(req.body)
      DB.configs.delete({"type": "active"})
      body_parsed["type"] = "active"
      DB.configs.insert(body_parsed)
      return {"status": 200, "headers": {"Content-Type": "application/json"}, "body": to_json({"status": "success", "message": "Configuration saved to database"})}
    } catch (err) {
      return {"status": 500, "headers": {"Content-Type": "application/json"}, "body": to_json({"error": "Failed to save: " + str(err)})}
    }
  }

  if req.method == "GET" && req.path == "/load-config" {
    try {
      let results = DB.configs.find({"type": "active"})
      if len(results) > 0 {
        return {"status": 200, "headers": {"Content-Type": "application/json"}, "body": to_json(results[0])}
      }
    } catch (err) {}
    
    let defaults = {
      "tempo": "120",
      "swing": "0.0",
      "key": "",
      "structure": "",
      "genre": "",
      "mood": "",
      "instruments": "",
      "notes": ""
    }
    return {"status": 200, "headers": {"Content-Type": "application/json"}, "body": to_json(defaults)}
  }
  
  return null
}
