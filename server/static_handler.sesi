allow "helpers/safe" in as Safe
allow "tags" in with {tags}

export fn handle_static(req) {
  if req.method == "GET" && req.path == "/" {
    try {
      return {status: 200, headers: {"Content-Type": "text/html", "Cache-Control": "no-cache, no-store, must-revalidate"}, body: Safe.readFile("static/index.html")}
    } catch (e) {
      return {status: 404, body: "Index file not found"}
    }
  }
  if req.method == "GET" && req.path == "/style.css" {
    try {
      return {status: 200, headers: {"Content-Type": "text/css", "Cache-Control": "no-cache, no-store, must-revalidate"}, body: Safe.readFile("static/style.css")}
    } catch (e) {
      return {status: 404, body: "CSS file not found"}
    }
  }
  if req.method == "GET" && req.path == "/studio.js" {
    try {
      return {status: 200, headers: {"Content-Type": "application/javascript", "Cache-Control": "no-cache, no-store, must-revalidate"}, body: Safe.readFile("static/studio.js")}
    } catch (e) {
      return {status: 404, body: "JS file not found"}
    }
  }
  if req.method == "GET" && (req.path == "/favicon.svg" || req.path == "/logo.svg") {
    try {
      return {status: 200, headers: {"Content-Type": "image/svg+xml"}, body: Safe.readFile("static/favicon.svg" || "static/logo.svg")}
    } catch (e) {
      return {status: 200, body: ""}
    }
  }
  if req.method == "GET" && req.path == "/tags" { return {status: 200, headers: {"Content-Type": "application/json"}, body: to_json(tags)} }
  if req.method == "GET" && req.path == "/last-generated-code" {
    try {
      return {status: 200, headers: {"Content-Type": "text/plain", "Cache-Control": "no-cache, no-store, must-revalidate"}, body: Safe.readFile(".generated_song.sesi")}
    } catch (e) {
      return {status: 404, headers: {"Content-Type": "text/plain"}, body: ""}
    }
  }
  return null
}