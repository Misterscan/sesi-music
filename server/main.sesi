/*
  Native Sesi Music Generation Web Server
  This server is built using Sesi's native web server capabilities.
  It handles static file serving, audio generation, configuration management, and AI-driven music composition.

  Usage:
    npm start
*/
allow "bin/ansi" in as TERM

let Static = live("server/static_handler.sesi", "handle_static")
let AudioService = live("server/audio_handler.sesi", "handle_audio")
let ConfigService = live("server/config_handler.sesi", "handle_config")
let AIService = live("server/ai_handler.sesi", "handle_ai")

fn handleRequest(req) {
  TERM.badge(req.method, req.path)
  
  let res = Static(req)
  if !(res | is_null) { return res }
  
  res = AudioService(req)
  if !(res | is_null) { return res }
  
  res = ConfigService(req)
  if !(res | is_null) { return res }
  
  res = AIService(req)
  if !(res | is_null) { return res }
  
  return {status: 404, body: "Not found"}
}

let server = listen(8080, handleRequest)
TERM.box("🎵 Sesi Music Web Studio running 🎵")
try {
  open("http://localhost:8080")
} catch (e) {
  TERM.error("Failed to open browser: " + e)
  TERM.warning("Please open http://localhost:8080 in your browser manually.")
}

show "Press Ctrl+C anytime to stop the server...\n\n"