let sf2_docs = ""
try {
  sf2_docs = read_file("sf2/GeneralUser-GS.md")
} catch (err) {}

let second_love_code = ""
try {
  second_love_code = read_file("make/second_love.sesi")
  second_love_code = swap(second_love_code, "\"songs/second_love.wav\"", "\"output.wav\"")
  second_love_code = swap(second_love_code, "\"songs/second_love.mid\"", "\"output.mid\"")
} catch (err) {}

