  stadium_anthem_code = swap(stadium_anthem_code, "\"songs/stadium_anthem.wav\"", "\"output.wav\"")
  stadium_anthem_code = swap(stadium_anthem_code, "\"songs/stadium_anthem.mid\"", "\"output.mid\"")
} catch (err) {}

