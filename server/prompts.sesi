export let PREPACKAGED_EXAMPLES = {
  "A beautiful song that captures the feeling of falling in love for the second time.": {
    "brief": "### Style/Genre\nEmotional Ballad / Soft Pop\n\n### Section Plan\n- **Intro**: 4 bars. Ambient piano and strings.\n- **Verse**: 8 bars. Add acoustic guitar arpeggios.\n- **Pre-Chorus**: 4 bars. Tension build, classical resolution.\n- **Chorus**: 16 bars. Soaring lead synth melody, full drums.\n- **Outro**: 4 bars. Soft acoustic guitar fade out.\n*Total 36 bars*",
    "code": second_love_code
  },
  "An epic, high-energy entrance theme for a championship football game.": {
    "brief": "### Style/Genre\nEpic Stadium Rock / Brass Anthem\n\n### Section Plan\n- **Intro**: 4 bars. Heavy stadium drums and claps.\n- **Verse 1**: 8 bars. Add finger bass and soft brass stabs.\n- **Chorus**: 8 bars. Soaring brass melody and loud drums.\n- **Outro**: 4 bars. Heavy outro groove ending on final hit.\n*Total 24 bars*",
    "code": stadium_anthem_code
  },
  "A dreamy vaporwave track with a cassette vibe, dynamic neon cover art, and a saxophone lead.": {
    "brief": "### Style/Genre\nVaporwave / Dream Pop / Chillwave\n\n### Section Plan\n- **Intro**: 4 bars. Warm synth pad playing Fmaj7-Gmaj7-Em7-Am7 chords with 80 BPM drums.\n- **Verse**: 4 bars. Add glassy Tine EP arpeggios and slow synth bass.\n- **Chorus**: 8 bars. Tenor Saxophone plays a nostalgic, sweeping melody.\n- **Outro**: 4 bars. Saxophone rests, chords and keys fade out under drum groove.\n*Total 20 bars*",
    "code": vaporwave_code
  },
  "A stately processional fanfare and march featuring trumpets, French horns, trombones, strings, and timpani.": {
    "brief": "### Style/Genre\nStately Processional / Ceremonial Fanfare\n\n### Section Plan\n- **The Fanfare Call**: 4 bars. Bright Trumpet call in C Major with French Horn harmony and dramatic Timpani strikes.\n- **Processional Theme**: 8 bars. Majestic arpeggiated string outline and trombone stately bassline under trumpet main melody.\n- **Grand Climax**: 4 bars. Tutti call-and-response resolving to a final grand accent strike.\n*Total 16 bars*",
    "code": ceremonious_march_code
  },
  "A classic 4-bar disco groove featuring electric bass, Rhodes stabs, synth lead, and handclaps.": {
    "brief": "### Style/Genre\nSoundFont Disco / Dance / Groove\n\n### Section Plan\n- **Groove**: 4 bars. Four-on-the-floor kick drum, hi-hats on offbeats, stereo handclaps/snare on beats 2 & 4, electric bass, Rhodes stabs, and synth lead melody.\n*Total 4 bars*",
    "code": disco_song_code
  }
}

let examples_text = "\n### PREPACKAGED EXAMPLES FOR CORRECT USAGE ###\n"
let example_keys = keys(PREPACKAGED_EXAMPLES)
for key in example_keys {
  let data = PREPACKAGED_EXAMPLES[key]
  examples_text = examples_text + "Description: " + key + "\n\n"
  examples_text = examples_text + "-- Brief --\n" + data["brief"] + "\n\n"
  examples_text = examples_text + "-- Target Code --\n```sesi\n" + data["code"] + "\n```\n\n"
}

prompt STAGE1_SYS {"You are a musical creative director. Your job is to take a short, high-level description of a song or mood from a user and expand it into a detailed musical brief. 
This brief should include:
- Style/Genre
- Mood / Emotional Arc
- Tempo (BPM)
- Key / Scale
- Instrument Plan
- Core Musical Ideas
- Section Plan
- Arrangement Rules For Generation

Critical requirements:
1. The Section Plan must use explicit bar counts for every section, not timestamps.
2. Every section must specify how many bars it lasts, and the total form should be internally consistent.
3. Describe parts in ways that map cleanly to programming: chords, bassline, lead, pad, arpeggio, rests, repetitions, section reuse.
4. When silence is needed, describe it as a section-length rest with an exact bar count.
5. Keep the arrangement realistic for symbolic composition: focus on notes, rhythms, repetitions, layering, and entry/exit points.
6. For every active musical layer, make the duration expectations clear so Stage 2 can keep all tracks aligned.
7. Prefer section descriptions like '8 bars of chords with 8 bars of bass' rather than timestamp prose like '0:00-0:30'.

Example Input: \"A calm sunset\"

Example Output:
Title: (create one based on user input, e.g. \"Serenity Calls\")

### Style/Genre

### Mood / Emotional Arc

### Tempo (BPM)

### Key / Scale

### Instrument Plan

### Core Musical Ideas

### Section Plan

### Arrangement Rules For Generation"}

let presets_code = ""
try {
  presets_code = read_file("lib/presets.sesi")
} catch (err) {}

prompt STAGE2_SYS {"You are an expert Sesi programmer. Your job is to take a detailed musical brief and generate valid .sesi code to compose music.
Follow these syntax rules based squarely on the Sesi audio documentation:
1. Output ONLY the Sesi code. No explanations, no markdown blocks.
2. ALWAYS start with:
allow 'std/theory' in with Music // <-- Use double quotes for strings, NOT single quotes
allow 'std/audio' in with Audio
allow 'lib/presets' in with Presets
3. Define BPM and calculate BAR_MS: let BPM = <val>; let BAR_MS = Music.bar(1.0, BPM)
4. Use Presets.sf2 for instruments: let inst = Audio.sf2(\"sf2/GeneralUser-GS.sf2\", {\"instrument\": <GM_ID>})
5. Refer to the GM instrument list provided to find the correct GM_ID integers.
6. For drums, you MUST use the provided preset functions: Presets.kick, Presets.snare, Presets.hat, Presets.clap.
7. Use Presets.step_sequence(pattern, instrument_fn, BPM) to create drum beats easily.
8. Structure your songs logically! Build tracks using arrays and push(). Use loops or arrays to arrange sections.
9. Keep the full arrangement aligned to the requested total length conceptually.
10. Combine tracks: let all_tracks = [track1, track2, ...]
11. Output the file:
try {
  Presets.render_song(\"output.wav\", all_tracks) // <-- DO NOT CHANGE THIS FILENAME OR EXTENSION!
} catch (err) {
  print err
}
12. NEVER use the `+` operator for arrays, use `push()`.
13. After render_song, ALWAYS export MIDI by calling: Audio.midi(\"output.mid\", all_tracks)

### PRESETS API CODE DEFINITION (Shows available methods on Presets module) ###
" presets_code "

### GM INSTRUMENT LIST ###
" sf2_docs "

" examples_text}

export fn get_stage1_prompt(prompt_text: string, config_text: string) -> string {
  prompt stage1_prompt {STAGE1_SYS "
  User Request: " prompt_text "
  Config: " config_text}
  return stage1_prompt
}

export fn get_stage2_prompt(brief: string) -> string {
  prompt stage2_prompt {STAGE2_SYS "
  Write a complete .sesi script based on this Musical Brief:
  " brief}
  return stage2_prompt
}

export fn get_repair_prompt(last_error: string, code: string) -> string {
  prompt repair_prompt {STAGE2_SYS "
  The following .sesi code failed with error: " last_error "
  Please fix the code so it compiles and runs perfectly. Output full corrected code only.
  Code:
  " code}
  return repair_prompt
}

export fn get_revision_prompt(brief: string, req_text: string, original_code: string) -> string {
  prompt revise_prompt {STAGE2_SYS "
  Revise the current .sesi composition according to the user request.
  Original brief:" brief "
  User change request:" req_text "
  Original code:" original_code "
  Return full replacement .sesi code only."}
  return revise_prompt
}
