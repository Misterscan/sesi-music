// Preset Drum Sounds (Native Physical Modeling)
// Redefined to match instrument signatures (note, duration, options)

export fn kick(note: string, duration: number, options: object = null) {
  let pitch = "C1"
  if note != "x" && note != "hit" && note != "" && note != null {
    pitch = note
  }
  let note_obj = {"note": pitch, "ms": duration, "type": "kick"}
  if options != null {
    if options["vol"] != null { note_obj["vol"] = options["vol"] }
    if options["pan"] != null { note_obj["pan"] = options["pan"] }
  }
  return note_obj
}

