// presets.sesi
// Preset instruments and DAW-style step sequencer for Sesi Audio projects.

allow "std/audio" in with Audio
allow "std/theory" in with Music
allow "std/math" in with Math


let SF2_PATH = "sf2/GeneralUser-GS.sf2"
let loaded_instruments = {}

// Set the SoundFont file path dynamically.
export fn set_sf2_path(path: string) {
  SF2_PATH = path
  loaded_instruments = {}
}

// Retrieve or load a SoundFont instrument lazily.
fn get_instrument(program: number, gain: number = 1.0) {
  let key = str(program)
  if loaded_instruments[key] == null {
    loaded_instruments[key] = Audio.sf2(SF2_PATH, {"instrument": program, "gain": gain})
  }
  return loaded_instruments[key]
}

// Preset Instruments (SoundFont GS GM program maps)

export fn piano(note: string, duration: number, options: object = null) {
  let inst = get_instrument(0, 1.5)
  let note_obj = inst(note, duration)
  if options != null {
    if options["vol"] != null { note_obj["vol"] = options["vol"] }
    if options["pan"] != null { note_obj["pan"] = options["pan"] }
    if options["cutoff"] != null { note_obj["cutoff"] = options["cutoff"] }
  }
  return note_obj
}

