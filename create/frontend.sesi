// Programmatic generation of the Sesi Music Studio DAW web interface.

show "🎨 Building native Sesi Music Studio DAW frontend assets..."

try {
  if list_dir("static") == null {
    make_dir("static")
  }
} catch (err) {
  show "Directory static already exists or cannot be created:" err
}

allow "helpers/safe" in as Safe
allow "html" in as H
allow "css" in as C
allow "js" in as J

try {
  Safe.writeFile("static/index.html", H.page)
} catch (err) {
  show "Error writing static/index.html:" err
}

try {
  Safe.writeFile("static/style.css", C.css)
} catch (err) {
  show "Error writing static/style.css:" err
}

try {
  Safe.writeFile("static/studio.js", J.script)
} catch (err) {
  show "Error writing static/studio.js:" err
}

show "🎉 Sesi Music native studio frontend assets successfully generated!"